# Chave da API do Gemini, usada pelas rotas de servidor.
# NÃO comitar valor real. Em produção, use:
#   wrangler secret put GEMINI_API_KEY
GEMINI_API_KEY=""

# URL pública do app. Em Workers vem do domínio do deploy.
APP_URL="http://localhost:3000"

# Mapa — MapLibre usa tiles vetoriais abertos; busca, endereço do ponto e rota passam pelo BFF.
# -----------------------------------------------------------------------------
# Supabase — SEM prefixo NEXT_PUBLIC_, de propósito.
#
# Estas três só são lidas por route handler, middleware e Server Component. Com
# `NEXT_PUBLIC_` elas iriam para o bundle do browser, e a service role no bundle
# é o fim do isolamento por RLS: ela ignora toda policy.
#
# Valores de desenvolvimento: `npx supabase status` no repositório do backend.
# -----------------------------------------------------------------------------
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Quanto tempo um pedido de acesso vive. O `otp_expiry` do GoTrue acompanha
# (supabase/config.toml no backend) — os dois precisam vencer junto, senão um
# código válido encontra um pedido que já sumiu.
AUTH_PEDIDO_TTL_MS="900000"
AUTH_REENVIO_MS="60000"
AUTH_MAX_TENTATIVAS_OTP="5"

# Login social. Só marque como true depois de configurar o provider no projeto
# Supabase; as chaves OAuth ficam exclusivamente nele, nunca neste frontend.
AUTH_GOOGLE_ENABLED="false"
AUTH_APPLE_ENABLED="false"

# -----------------------------------------------------------------------------
# E-mail operacional. O worker Nest chama a rota interna abaixo; só o BFF tem
# a chave Brevo. Em Cloudflare, cadastre estes valores com `wrangler secret put`.
BREVO_API_KEY=""
BREVO_REMETENTE=""
NOTIFICACOES_INTERNAS_TOKEN=""

# -----------------------------------------------------------------------------
# Canais de atendimento mostrados na tela de suporte.
#
# Sem valor padrão de propósito: o mock trazia `5551999999999`, que é número de
# exemplo. Telefone falso numa tela de suporte é pior que cartão desligado —
# alguém liga. Vazio faz o cartão aparecer como indisponível.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CONTATO_WHATSAPP=""
NEXT_PUBLIC_CONTATO_TELEFONE=""
NEXT_PUBLIC_CONTATO_EMAIL=""
