# Chave da API do Gemini, usada pelas rotas de servidor.
# NÃO comitar valor real. Em produção, use:
#   wrangler secret put GEMINI_API_KEY
GEMINI_API_KEY=""

# URL pública do app. Em Workers vem do domínio do deploy.
APP_URL="http://localhost:3000"

# Google Maps — usada pelo LocationPickerMap na tela de contratação.
# NEXT_PUBLIC_ é obrigatório: sem o prefixo, o vinext não embute o valor no
# bundle do cliente e o mapa não carrega.
# Esta chave FICA VISÍVEL no browser. Restrinja por domínio no console do
# Google Cloud — é a única proteção que existe para chave de front.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
